# Spiral Inward — required environment variables.
# Copy to .env.development.local and fill in real values for local work.
# All of these are required; the app throws at startup if any are missing.

# --- Supabase (auth, fragments, reads, profiles, charts) -----------------------
# Both values are PUBLIC by design (shipped to the browser). Copy them from
# Supabase dashboard > Project Settings > API.
# These are inlined at BUILD time, so they must be set in the build environment.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_your_key_here"

# --- Neon Postgres (people, relationships, user_progress) ---------------------
# Pooled connection string. Server-side only — never expose to the browser.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# --- Internal tooling access (/brain, /chart-test) ----------------------------
# The Supabase AUTH user id (auth.users.id) of the single owner account allowed
# to open the internal tooling pages. Server-side only — do NOT prefix with
# NEXT_PUBLIC_, or it would be shipped to the browser.
#
# This is the auth user id, NOT a `people` or `profiles` row id. Find it in
# Supabase dashboard > Authentication > Users, or by running:
#   select id, email from auth.users order by created_at limit 5;
#
# The gate FAILS CLOSED: if this is unset or blank, no one reaches the tooling
# (every signed-in visitor is redirected to /circle) rather than it falling back
# to allowing any signed-in user.
ADMIN_USER_ID="00000000-0000-0000-0000-000000000000"

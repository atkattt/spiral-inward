# Spiral Inward — required environment variables.
# Copy to .env.development.local and fill in real values for local work.
# All of these are required; the app throws at startup if any are missing.

# --- Supabase (auth, fragments, reads, profiles, charts) -----------------------
# Both values are PUBLIC by design (shipped to the browser). Copy them from
# Supabase dashboard > Project Settings > API.
# These are inlined at BUILD time, so they must be set in the build environment.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_your_key_here"

# --- Neon Postgres (people, relationships, user_progress) ---------------------
# Pooled connection string. Server-side only — never expose to the browser.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"
